{
  "recording": {
    "video": {
      "width": 1920,
      "height": 1080,
      "fps": 5,
      "bitrate": 500000,
      "max_bitrate": 1200000,
      "rate_control": "CRF",
      "crf": 27,
      "keyint_sec": 30,
      "codec": "h264",
      "encoder": "auto",
      "preset": "slower",
      "layout": "equalTiles"
    },
    "audio": {
      "enabled": true,
      "sampleRate": 44100,
      "channels": 1,
      "bitrate": 32000,
      "noiseSuppression": "none"
    },
    "maxDurationSeconds": 3600,
    "outputFormat": "mp4"
  },
  "storage": {
    "maxDiskUsageGB": 10,
    "cleanupOnUpload": true
  },
  "logging": {
    "level": "info",
    "enableFileLogging": true,
    "maxFileSizeMB": 10,
    "maxFiles": 5
  }
}
